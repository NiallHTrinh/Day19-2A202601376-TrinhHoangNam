# cp .env.example .env
# --- Neo4j Database (Local Docker hoặc Neo4j AuraDB) ---
NEO4J_URI=neo4j+s://<your-instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# --- Extraction & Generation LLM (Groq) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# --- NER+RE Extraction (cell 2.1): openai | groq ---
EXTRACT_PROVIDER=openai
EXTRACT_MODEL=gpt-4o-mini

# --- Answer generation + seeds (cell 3.2, 3.4, 4.3): openai | groq ---
GENERATE_PROVIDER=openai
GENERATE_MODEL=gpt-4o-mini

# --- LLM-as-a-Judge (OpenAI hoặc Groq) ---
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-...

# --- Hugging Face Access Token (để stream dataset HackerNoon) ---
HF_TOKEN=hf_...
